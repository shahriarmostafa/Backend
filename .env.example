# Backend environment variables.
#
# Copy to .env for local work; on Render set them under
# Environment -> Environment Variables. Values here are placeholders.
#
# A missing Firebase key crashes the process at startup, before any route is
# mounted - firebase.config.js now names which ones are absent.

# --- Firebase service account (all 11 required) -----------------------------
# Straight from the service account JSON you download from Firebase.
# VITE_private_key must keep its literal \n escapes, quoted:
#   VITE_private_key="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
VITE_type=service_account
VITE_project_id=
VITE_private_key_id=
VITE_private_key=
VITE_client_email=
VITE_client_id=
VITE_auth_uri=https://accounts.google.com/o/oauth2/auth
VITE_token_uri=https://oauth2.googleapis.com/token
VITE_auth_provider_x509_cert_url=https://www.googleapis.com/oauth2/v1/certs
VITE_client_x509_cert_url=
VITE_universe_domain=googleapis.com

# --- MongoDB ----------------------------------------------------------------
USERNAME_DB=
PASSWORD_DB=

# --- Auth gate --------------------------------------------------------------
# false = log rejections but let the request through. Set false BEFORE the
# first deploy that includes the auth middleware, or every client 401s.
AUTH_ENFORCE=false
# transitional: accept a bare uid where a Firebase ID token is expected
ALLOW_LEGACY_UID_TOKEN=false

# --- CORS -------------------------------------------------------------------
# Comma-separated. Unset means every origin is accepted, which the server
# warns about on boot.
ALLOWED_ORIGINS=

# --- ShurjoPay --------------------------------------------------------------
SP_ENDPOINT=
SP_USERNAME=
SP_PASSWORD=
SP_PREFIX=
SP_RETURN_URL=
SP_CANCEL_URL=

# --- Agora (calls) ----------------------------------------------------------
APP_ID=
APP_CERTIFICATE=

# --- Supabase (file/audio storage) ------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=

# --- Server -----------------------------------------------------------------
# Render sets this itself.
PORT=5000
