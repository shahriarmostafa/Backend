# Copy to .env and fill in real values. NEVER commit .env.
# Every value below was previously committed to git history and must be
# treated as compromised until rotated at its provider.

# --- MongoDB Atlas ---
USERNAME_DB=
PASSWORD_DB=

# --- Firebase service account (Project settings > Service accounts) ---
# VITE_private_key keeps the literal \n escapes from the downloaded JSON.
VITE_type=service_account
VITE_project_id=
VITE_private_key_id=
VITE_private_key=
VITE_client_email=
VITE_client_id=
VITE_auth_uri=https://accounts.google.com/o/oauth2/auth
VITE_token_uri=https://oauth2.googleapis.com/token
VITE_auth_provider_x=https://www.googleapis.com/oauth2/v1/certs
VITE_client_x=
VITE_universe_domain=googleapis.com

# --- Agora (voice/video) ---
APP_ID=
APP_CERTIFICATE=

# --- Supabase ---
VITE_SUPABASE_ANON_KEY=

# --- ShurjoPay ---
SP_ENDPOINT=
SP_USERNAME=
SP_PASSWORD=
SP_PREFIX=
SP_RETURN_URL=
SP_CANCEL_URL=

# --- Whiteboard ---
AUTHORIZATION_TOKEN=

# --- Security controls (see SECURITY-ROLLOUT.md) ---
# AUTH_ENFORCE=false temporarily accepts unauthenticated requests during a
# staged rollout. Leave unset (or "true") in normal operation.
AUTH_ENFORCE=true
# ALLOW_LEGACY_UID_TOKEN=true lets /createCustomToken accept a raw uid, which
# is an account-takeover hole. Only enable while old app builds are in the
# wild, and remove it as soon as they are updated.
ALLOW_LEGACY_UID_TOKEN=false
# Comma-separated allowed browser origins. Unset means allow all (unsafe).
ALLOWED_ORIGINS=https://app.poperl.com
